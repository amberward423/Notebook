<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>


<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="500.0" spacing="10.0" style="-fx-background-color: #FCE4EC;;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.NoteController">
   <children>
      <Label text="Notebook" />
      <TextField fx:id="titleField" text="Enter note title ..." />
      <TextArea fx:id="contentArea" prefHeight="200.0" prefWidth="200.0" text="Write note here" />
      <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAddNote" style="-fx-background-color: #EC407A;; -fx-text-fill: white;; -fx-background-radius: 8;" text="Add" />
      <Label text="Saved Notes" />
      <TextArea fx:id="savedNotesArea" editable="false" prefHeight="150.0" prefWidth="200.0" />
   </children>
</VBox>
